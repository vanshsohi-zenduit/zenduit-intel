# ── Gemini (required) ─────────────────────────────────────────────────────────
GOOGLE_API_KEY=AIza...your-gemini-key-here

# ── Gemini model overrides (optional) ────────────────────────────────────────
GEMINI_RESEARCH_MODEL=gemini-3.1-flash-lite
GEMINI_GENERATION_MODEL=gemini-3.1-flash-lite

# ── Brain MCP (optional — enhances product context + similar accounts) ────────
BRAIN_MCP_URL=https://company-brain-production-aacf.up.railway.app/
BRAIN_MCP_API_KEY=

# ── n8n (optional — delegates LinkedIn/web research to your n8n instance) ────
N8N_BASE_URL=https://n8n.srv1567300.hstgr.cloud/
N8N_RESEARCH_WEBHOOK_PATH=https://n8n.srv1567300.hstgr.cloud/webhook/c6068f5d-57e5-4fc7-8d4c-d0ba3ec7f577
N8N_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
ALLOWED_ORIGIN=http://localhost:8080

# ── Auth (multi-user login) ───────────────────────────────────────────────────
# Sign JWTs with a strong random secret (e.g. `openssl rand -hex 32`). REQUIRED
# unless AUTH_DISABLED=1. Rotating it invalidates all existing sessions.
JWT_SECRET=
JWT_TTL_HOURS=12
# Seeded on first startup if this user doesn't exist yet (idempotent).
ADMIN_EMAIL=admin@zenduit.com
ADMIN_PASSWORD=change-me-now
# Set to 1 ONLY for local dev without auth. Leave UNSET for any public deploy.
AUTH_DISABLED=

# ── Database (Postgres — users/auth only) ─────────────────────────────────────
# In docker compose these seed the postgres container AND build DATABASE_URL
# (which compose overrides with host `postgres`). For running outside Docker,
# set DATABASE_URL yourself, e.g. postgresql+asyncpg://user:pw@localhost:5432/intel
POSTGRES_USER=intel
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=intel
# DATABASE_URL=postgresql+asyncpg://intel:change-me-strong@localhost:5432/intel
